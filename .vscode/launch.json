{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SkillsTestProj: Debug Web (HTTP)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build SkillsTestProj",
            "program": "${workspaceFolder}/bin/Debug/net10.0/SkillsTestProj.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "launchSettingsProfile": "http",
            "stopAtEntry": false,
            "console": "internalConsole",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ]
}
